# Copy to .env and fill in. Never commit .env.

# Cerner open sandbox (no auth). For a secured tenant use https://fhir-ehr.cerner.com/r4/{tenant}
FHIR_BASE=https://fhir-open.cerner.com/r4/ec2458f2-1e24-41c8-b71b-0e701af7583d
# FHIR_BEARER_TOKEN=            # secured tenants only (SMART backend-services token)

# Offline demo: from the repo root run `uvicorn dev.mock_fhir:app --port 9000` and use
# FHIR_BASE=http://localhost:9000/r4/mock

# ---- Azure OpenAI ----
# Leave AOAI_ENDPOINT empty (or as the placeholder) to run with keyword rules only.
AOAI_ENDPOINT=https://<your-resource>.openai.azure.com
AOAI_DEPLOYMENT=gpt-4o-mini     # the DEPLOYMENT name in Azure, not the model name
AOAI_API_VERSION=2024-10-21
AOAI_API_KEY=                   # or leave empty, pip install azure-identity, and `az login`

# ---- Model knobs (restart uvicorn after changing) ----
# Try another deployment by changing AOAI_DEPLOYMENT above, e.g. gpt-4o, gpt-4.1-mini, gpt-5-mini.
AOAI_TEMPERATURE=0              # leave empty to send no temperature (gpt-5 / o-series need that)
AOAI_TIMEOUT=30                 # seconds per call

# ---- Cerner rate limiting ----
# The open sandbox throttles (HTTP 429). Every FHIR call shares this limit and
# 429/503 responses and timeouts are retried with backoff (Retry-After honoured).
FHIR_MAX_RPS=3                  # requests per second to Cerner; 0 = no limit
FHIR_CONCURRENCY=2              # LOINC searches in flight at once
FHIR_DOWNLOAD_CONCURRENCY=10    # Binary downloads in flight (each takes ~4 s on the sandbox)
FHIR_MAX_RETRIES=4              # retries per request on 429/503 and timeouts
FHIR_TIMEOUT=60                 # seconds per request (the sandbox is slow on big pages)
FHIR_MAX_PAGES=10               # pages per search (100 notes / 200 results each); more = complete but slower

# ---- Server / Windows ----
APP_HOST=127.0.0.1              # 0.0.0.0 to let other machines on the network open the app
APP_PORT=8000
USE_SYSTEM_CERTS=false          # true on corporate networks with HTTPS inspection (CERTIFICATE_VERIFY_FAILED)

# ---- Title matching ----
TITLE_MATCH_MIN=0.82            # 0-1 similarity for "close title match"; 1 = exact keyword only
