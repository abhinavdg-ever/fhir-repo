# Copy to .env and fill in. Never commit .env.

# ---- Cerner FHIR ----
# Open sandbox (no auth). Secured tenant: https://fhir-ehr.cerner.com/r4/{tenant}
FHIR_BASE=https://fhir-open.cerner.com/r4/ec2458f2-1e24-41c8-b71b-0e701af7583d
# FHIR_BEARER_TOKEN=            # secured tenants only (SMART backend-services token)
# Offline demo: run `uvicorn dev.mock_fhir:app --port 9000` and set FHIR_BASE=http://localhost:9000/r4/mock

# ---- Azure AI Foundry (the model that reads the service note) ----
# Leave AOAI_ENDPOINT as the placeholder to run with keyword rules only.
AOAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/
AOAI_API_KEY=                   # or leave empty, pip install azure-identity, and `az login`
# Deployment names for the model picker, comma separated. The first one is the default.
AOAI_MODELS=gpt-4o,gpt-4.1-mini,Llama-4-Maverick-17B-128E-Instruct-FP8,mistral-small-2503,claude-haiku-4-5
AOAI_TEMPERATURE=0              # empty = send no temperature (gpt-5 / o-series need that)
AOAI_TIMEOUT=30                 # seconds per call
# Cost figures use the prices in agent/llm.py (USD per 1M tokens). Override: [input, output, cached input]
# LLM_PRICES={"gpt-4o": [2.5, 10, 1.25]}

# ---- Redaction (phileas-redact, runs locally before every model call) ----
LLM_REDACT=true                 # false = send the note as typed
LLM_REDACT_DATES=true           # false = let the model see full dates (years are always kept)

# ---- Cerner rate limiting (429/503 and timeouts are retried with backoff) ----
FHIR_MAX_RPS=3                  # requests per second; 0 = no limit
FHIR_CONCURRENCY=2              # LOINC searches in flight
FHIR_DOWNLOAD_CONCURRENCY=10    # Binary downloads in flight
FHIR_MAX_RETRIES=4
FHIR_TIMEOUT=60                 # seconds per request
FHIR_MAX_PAGES=10               # pages per search; more = complete but slower

# ---- Server ----
APP_HOST=127.0.0.1              # 0.0.0.0 to open the app from other machines
APP_PORT=8000
USE_SYSTEM_CERTS=false          # true behind corporate HTTPS inspection (CERTIFICATE_VERIFY_FAILED)

# ---- Title matching ----
TITLE_MATCH_MIN=0.82            # 0-1 similarity for a close title match; 1 = exact keyword only
